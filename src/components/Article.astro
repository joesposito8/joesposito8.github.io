---
import { render } from 'astro:content';
import { TYPE_LABELS, formatDate, readingMinutes, hostname, type Post } from '../lib/posts';
import { SUBSTACK_SIGNUP } from '../config';
import DiscussLinks from './DiscussLinks.astro';
import CiteBlock from './CiteBlock.astro';
import SubstackSignup from './SubstackSignup.astro';
import Contents from './Contents.astro';
import EndMark from './EndMark.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { type, title, subtitle, date, updated, epistemic, tags, url } = post.data;
const { Content, headings } = await render(post);
const essay = type === 'essay';
---

<article class:list={['post', type, { 'with-rail': essay }]}>
  <header class="post-header">
    <h1>{type === 'link' && url ? <a href={url}>{title}</a> : title}</h1>
    {subtitle && <p class="post-subtitle">{subtitle}</p>}
    <p class="post-meta">
      <span class={`type sc t-${type}`}>{TYPE_LABELS[type]}</span>
      <span class="sep">·</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {
        updated && (
          <>
            <span class="sep">·</span>
            <span>
              updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </span>
          </>
        )
      }
      {
        essay && (
          <>
            <span class="sep">·</span>
            <span>{readingMinutes(post)} min read</span>
          </>
        )
      }
      {
        type === 'link' && url && (
          <>
            <span class="sep">·</span>
            <a href={url}>{hostname(url)}</a>
          </>
        )
      }
      {
        tags.length > 0 && (
          <>
            <span class="sep">·</span>
            <span class="post-tags">
              {tags.map((t) => (
                <a href={`/?tag=${encodeURIComponent(t)}#writing`}>{t}</a>
              ))}
            </span>
          </>
        )
      }
    </p>
    {epistemic && <p class="epistemic">Epistemic status: {epistemic}</p>}
  </header>
  {essay && <Contents headings={headings} />}
  <div class="post-main">
    <div class="post-body">
      <Content />
    </div>
    {essay && <EndMark />}
    <DiscussLinks post={post} />
    {essay && <CiteBlock post={post} />}
    {essay && SUBSTACK_SIGNUP && <SubstackSignup />}
  </div>
</article>

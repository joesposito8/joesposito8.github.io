---
import { render } from 'astro:content';
import { TYPE_LABELS, formatDate, readingMinutes, hostname, type Post } from '../lib/posts';
import DiscussLinks from './DiscussLinks.astro';
import CiteBlock from './CiteBlock.astro';
import SubstackSignup from './SubstackSignup.astro';
import Contents from './Contents.astro';
import EndMark from './EndMark.astro';

interface Props {
  post: Post;
  /** Essays get a contents list, expanded or folded; omitted, there is none. */
  toc?: 'open' | 'closed';
  /** Close essays with the sun mark before the discussion links. */
  endMark?: boolean;
}

const { post, toc, endMark = false } = Astro.props;
const { type, title, subtitle, date, updated, epistemic, tags, url } = post.data;
const { Content, headings } = await render(post);
---

<article class={`post ${type}`}>
  <header class="post-header">
    <h1>{type === 'link' && url ? <a href={url}>{title}</a> : title}</h1>
    {subtitle && <p class="post-subtitle">{subtitle}</p>}
    <div class="post-meta">
      <span class={`badge t-${type}`}>{TYPE_LABELS[type]}</span>
      <span class="sep"> · </span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {
        updated && (
          <>
            <span class="sep"> · </span>
            <span>updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>
          </>
        )
      }
      {
        type === 'essay' && (
          <>
            <span class="sep"> · </span>
            <span>{readingMinutes(post)} min read</span>
          </>
        )
      }
      {
        type === 'link' && url && (
          <>
            <span class="sep"> · </span>
            <a href={url}>{hostname(url)}</a>
          </>
        )
      }
      {
        tags.length > 0 && (
          <>
            <span class="sep"> · </span>
            <span>{tags.map((t) => `#${t}`).join(' ')}</span>
          </>
        )
      }
    </div>
    {epistemic && <p class="epistemic">Epistemic status: {epistemic}</p>}
  </header>
  {toc && type === 'essay' && <Contents headings={headings} open={toc === 'open'} />}
  <div class="post-main">
    <div class="post-body">
      <Content />
    </div>
    {endMark && type === 'essay' && <EndMark />}
    <DiscussLinks post={post} />
    {type === 'essay' && <CiteBlock post={post} />}
    {type === 'essay' && <SubstackSignup />}
  </div>
</article>

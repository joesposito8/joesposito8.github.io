---
import { render } from 'astro:content';
import { TYPE_LABELS, formatDate, groupBy, hostname, readingMinutes, type Post } from '../../lib/posts';

interface Props {
  posts: Post[];
  base: string;
  /** Show note, TIL and link bodies inline; otherwise every post is a title line. */
  bodies: boolean;
}

const { posts, base, bodies } = Astro.props;
const bodyById = new Map(
  bodies ? await Promise.all(posts.filter((p) => p.data.type !== 'essay').map(async (p) => [p.id, (await render(p)).Content] as const)) : [],
);
const href = (p: Post) => `${base}posts/${p.id}/`;
const years = groupBy(posts, (p) => String(p.data.date.getUTCFullYear()));
---

{/* The data attributes feed the filter and sort controls; without script the list stays newest first. */}
<div class="stream">
  {
    years.map(([year, items]) => (
      <>
        <div class="year" data-year={year}>
          <span>{year}</span>
        </div>
        {items.map((p) => {
          const { type, title, subtitle, date, tags, url } = p.data;
          const Body = bodyById.get(p.id);
          const minutes = readingMinutes(p);
          return (
            <article class={`item ${type} t-${type}`} data-type={type} data-tags={tags.join(' ')} data-date={date.toISOString()} data-minutes={minutes}>
              <div class="meta">
                <time datetime={date.toISOString()}>
                  {formatDate(date, 'day-month')}
                  <span class="yr"> {year}</span>
                </time>
                <span class="type">{TYPE_LABELS[type]}</span>
                {type === 'essay' && <span class="mins">{minutes} min</span>}
              </div>
              <div class="content">
                <h3>
                  <a href={type === 'link' ? url : href(p)}>{title}</a>
                  {type === 'link' && url && <span class="host"> → {hostname(url)}</span>}
                </h3>
                {type === 'essay' && subtitle && <p class="summary">{subtitle}</p>}
                {Body && (
                  <div class="body">
                    <Body />
                  </div>
                )}
                {tags.length > 0 && (
                  <p class="tags">
                    {tags.map((t) => (
                      <span>{t}</span>
                    ))}
                  </p>
                )}
              </div>
            </article>
          );
        })}
      </>
    ))
  }
</div>

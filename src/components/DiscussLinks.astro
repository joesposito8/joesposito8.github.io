---
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { lesswrong, substack, x } = Astro.props.post.data.syndication;
// Alphabetical by name, so the order never depends on which link was added first.
const links = (
  [
    lesswrong && { label: 'LessWrong', href: lesswrong },
    substack && { label: 'Substack', href: substack },
    x && { label: 'X', href: x },
  ].filter(Boolean) as { label: string; href: string }[]
).sort((a, b) => a.label.localeCompare(b.label));
---

{
  links.length > 0 && (
    <p class="discuss">
      Discuss on{' '}
      {links.map((l, i) => (
        <>
          {i > 0 && <span class="sep"> · </span>}
          <a href={l.href}>{l.label}</a>
        </>
      ))}
    </p>
  )
}

---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// remark-gfm adds a visually hidden "Footnotes" heading; readers reach footnotes from their markers.
const entries = Astro.props.headings.filter((h) => h.depth <= 3 && h.slug !== 'footnote-label');
---

{
  entries.length > 1 && (
    <nav class="toc rail" aria-label="Contents">
      <details open>
        <summary class="sc">Contents</summary>
        <ol>
          {entries.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

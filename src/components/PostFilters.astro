---
import { POST_TYPES } from '../content.config';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const PLURALS = { essay: 'Essays', note: 'Notes', til: 'TILs', link: 'Links' } as const;
const SORTS = [
  ['newest', 'Newest'],
  ['oldest', 'Oldest'],
  ['longest', 'Longest'],
] as const;

const tagCounts = new Map<string, number>();
for (const tag of posts.flatMap((p) => p.data.tags)) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const tags = [...tagCounts].sort(([a, m], [b, n]) => n - m || a.localeCompare(b)).map(([tag]) => tag);
---

{/* Hidden until the script runs, so a reader without JavaScript never sees controls that do nothing. */}
<form class="filters rail" hidden aria-label="Filter and sort">
  <fieldset>
    <legend class="sc">Show</legend>
    <div class="options">
      <label><input type="radio" name="type" value="all" checked /><span>All <span class="n" data-count="all">{posts.length}</span></span></label>
      {
        POST_TYPES.map((type) => (
          <label>
            <input type="radio" name="type" value={type} />
            <span>
              {PLURALS[type]} <span class="n" data-count={type}>{posts.filter((p) => p.data.type === type).length}</span>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <fieldset>
    <legend class="sc">Topic</legend>
    <div class="options">
      <label><input type="radio" name="tag" value="all" checked /><span>All</span></label>
      {
        tags.map((tag) => (
          <label>
            <input type="radio" name="tag" value={tag} />
            <span>{tag}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <fieldset>
    <legend class="sc">Sort</legend>
    <div class="options">
      {
        SORTS.map(([value, label], i) => (
          <label>
            <input type="radio" name="sort" value={value} checked={i === 0} />
            <span>{label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <p class="f-status" aria-live="polite"></p>
</form>
<p class="f-empty" hidden>Nothing matches. <button type="button">Show everything</button></p>

<script>
  type Key = 'type' | 'tag' | 'sort';
  const DEFAULTS: Record<Key, string> = { type: 'all', tag: 'all', sort: 'newest' };
  const KEYS = Object.keys(DEFAULTS) as Key[];

  const form = document.querySelector<HTMLFormElement>('form.filters');
  const list = document.querySelector<HTMLElement>('.post-list');
  const empty = document.querySelector<HTMLElement>('.f-empty');

  if (form && list && empty) {
    const entries = [...list.querySelectorAll<HTMLElement>('.entry')];
    const yearMarkers = new Map([...list.querySelectorAll<HTMLElement>('.year')].map((el) => [el.dataset.year, el]));
    const status = form.querySelector<HTMLElement>('.f-status')!;

    const byDate = (a: HTMLElement, b: HTMLElement) => a.dataset.date!.localeCompare(b.dataset.date!);
    const ORDERS: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      newest: (a, b) => byDate(b, a),
      oldest: byDate,
      longest: (a, b) => Number(b.dataset.minutes) - Number(a.dataset.minutes) || byDate(b, a),
    };

    const read = () => {
      const data = new FormData(form);
      return Object.fromEntries(KEYS.map((k) => [k, String(data.get(k) ?? DEFAULTS[k])])) as Record<Key, string>;
    };

    const select = (state: Partial<Record<Key, string>>) => {
      for (const k of KEYS) {
        const input = form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${CSS.escape(state[k] ?? DEFAULTS[k])}"]`);
        if (input) input.checked = true;
      }
    };

    const apply = () => {
      const state = read();
      const inTopic = entries.filter((el) => state.tag === 'all' || el.dataset.tags!.split(' ').includes(state.tag));
      // Type counts follow the chosen topic, so each option says how many posts it would show.
      for (const n of form.querySelectorAll<HTMLElement>('[data-count]')) {
        const type = n.dataset.count;
        const count = type === 'all' ? inTopic.length : inTopic.filter((el) => el.dataset.type === type).length;
        n.textContent = String(count);
        n.closest('label')!.classList.toggle('none', count === 0);
      }
      const shown = inTopic.filter((el) => state.type === 'all' || el.dataset.type === state.type).sort(ORDERS[state.sort] ?? ORDERS.newest);

      // Year markers only make sense in date order; sorted by length, each date shows its year instead.
      const byYear = state.sort !== 'longest';
      const nodes: HTMLElement[] = [];
      let year: string | undefined;
      for (const el of shown) {
        const y = el.dataset.date!.slice(0, 4);
        if (byYear && y !== year) nodes.push(yearMarkers.get(y)!);
        year = y;
        nodes.push(el);
      }
      list.replaceChildren(...nodes);
      list.dataset.sort = state.sort;
      status.textContent = shown.length === entries.length ? `${entries.length} posts` : `${shown.length} of ${entries.length} posts`;
      empty.hidden = shown.length > 0;

      const query = new URLSearchParams(KEYS.filter((k) => state[k] !== DEFAULTS[k]).map((k) => [k, state[k]])).toString();
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    };

    select(Object.fromEntries(new URLSearchParams(location.search)));
    form.addEventListener('change', apply);
    empty.querySelector('button')!.addEventListener('click', () => {
      select({ sort: read().sort });
      apply();
    });
    form.hidden = false;
    apply();
  }
</script>

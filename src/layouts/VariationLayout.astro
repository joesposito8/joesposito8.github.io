---
// Self-hosted through Vite: the font files ship with the site, so no request leaves it.
// Browsers only download the faces a page actually uses.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/alegreya/wght.css';
import '@fontsource-variable/alegreya/wght-italic.css';
import '@fontsource/alegreya-sc/500.css';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/figtree/wght.css';
import '@fontsource-variable/figtree/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/base.css';
import '../styles/variations.css';
import { VARIATIONS, SHOWCASE_ESSAY, type VariationId } from '../lib/variations';

interface Props {
  variant: VariationId;
  page: 'home' | 'essay' | 'post';
  title: string;
  /** The post shown, so the variation links keep the reader on the same post. */
  slug?: string;
}

const { variant, page, title, slug } = Astro.props;
const v = VARIATIONS[variant];
const swatches = ['--bg', '--fg', '--muted', '--rule', '--accent', '--code-bg'];
---

<!doctype html>
<html lang="en" data-variant={variant} data-timeline={v.timeline ? '' : undefined} data-list={v.filters ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="vbanner">
      <div class="vbar">
        <span>
          Variation:
          {
            Object.entries(VARIATIONS).map(([id, info]) => (
              <>
                {' '}
                <a class={id === variant ? 'on' : undefined} href={`/variations/${id}/${slug ? `posts/${slug}/` : ''}`}>
                  {id.toUpperCase()} {info.name}
                </a>
              </>
            ))
          }
        </span>
        <span>
          Page:
          <a class={page === 'home' ? 'on' : undefined} href={`/variations/${variant}/`}>Home</a>
          <a class={page === 'essay' ? 'on' : undefined} href={`/variations/${variant}/posts/${SHOWCASE_ESSAY}/`}>Essay</a>
        </span>
        <span>
          Theme:
          <button type="button" data-set-theme="system">System</button>
          <button type="button" data-set-theme="light">Light</button>
          <button type="button" data-set-theme="dark">Dark</button>
        </span>
        <span class="swatches" title={swatches.join(' ')}>
          {swatches.map((s) => <span class="sw" style={`background: var(${s})`} title={s} />)}
        </span>
        <span class="spec">{v.spec}</span>
      </div>
    </div>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href={`/variations/${variant}/`}><span class="site-avatar" aria-hidden="true">JE</span>Joey Esposito</a>
        <nav class="site-nav" aria-label="Site">
          <a href={`/variations/${variant}/`}>Archive</a>
          <a href={`/variations/${variant}/`}>About</a>
          <a href={`/variations/${variant}/`}>Evals</a>
          <a href={`/variations/${variant}/`}>Feed</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        Joey Esposito · <a href="#">GitHub</a> · <a href="#">X</a> · <a href="#">LessWrong</a> · <a href="#">Substack</a> · <a href="#">Feed</a>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const buttons = document.querySelectorAll('[data-set-theme]');
      const mark = () =>
        buttons.forEach((b) => b.setAttribute('aria-pressed', String((root.dataset.theme ?? 'system') === b.dataset.setTheme)));
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const t = b.dataset.setTheme;
          if (t === 'system') delete root.dataset.theme;
          else root.dataset.theme = t;
          try {
            t === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', t);
          } catch {}
          mark();
        }),
      );
      mark();
    </script>
  </body>
</html>

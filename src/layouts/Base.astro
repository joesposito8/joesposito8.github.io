---
// Fonts are bundled with the site, so no request leaves it; browsers fetch only the faces a page uses.
import '@fontsource-variable/alegreya/wght.css';
import '@fontsource-variable/alegreya/wght-italic.css';
import '@fontsource/alegreya-sc/500.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { CONTACT_EMAIL, COUNTER_URL, EXTRA_REL_ME, NAV, PROFILES, SITE } from '../config';
// Every page sets its name, nav and opening text in these two faces; preloading them starts
// the downloads with the page instead of after the stylesheet.
import alegreyaUrl from '@fontsource-variable/alegreya/files/alegreya-latin-wght-normal.woff2?url';
import alegreyaScUrl from '@fontsource/alegreya-sc/files/alegreya-sc-latin-500-normal.woff2?url';

interface Props {
  /** Page title; the site name is appended except on the home page. */
  title?: string;
  description?: string;
  /** Social card image path, relative to the site root. */
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.description, image = '/og/index.png', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : undefined;
const current = (href: string) => (href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href));
// The address goes into the page reversed and base64-encoded; the footer script decodes it.
const encodedEmail = CONTACT_EMAIL && btoa([...`${CONTACT_EMAIL.user}@${CONTACT_EMAIL.domain}`].reverse().join(''));
const EMAIL_SCRIPT = `for (const el of document.querySelectorAll('.footer-email')) {
  el.querySelector('a').href = 'mailto:' + [...atob(el.dataset.e)].reverse().join('');
  el.hidden = false;
}`;
// One cookieless request per page shown. A prerendered page waits until the reader opens it,
// and automated browsers send nothing.
const COUNTER_SCRIPT = `const send = () => {
  const ref = document.referrer && new URL(document.referrer).hostname;
  fetch(${JSON.stringify(COUNTER_URL)}, { method: 'POST', mode: 'no-cors', keepalive: true, credentials: 'omit',
    body: JSON.stringify({ p: location.pathname, r: ref }) }).catch(() => {});
};
if (!navigator.webdriver) {
  if (document.prerendering) document.addEventListener('prerenderingchange', send, { once: true });
  else send();
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={alegreyaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={alegreyaScUrl} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: all posts`} href="/feeds/all.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: essays`} href="/feeds/essays.xml" />
    {[...PROFILES.map((p) => p.href), ...EXTRA_REL_ME].map((href) => <link rel="me" href={href} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">{SITE.name}</a>
      <nav class="site-nav" aria-label="Site">
        {
          NAV.map(({ href, label }) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer">
      {SITE.name}
      {
        PROFILES.map(({ label, href }) => (
          <>
            {' · '}
            <a href={href} rel="me">{label}</a>
          </>
        ))
      }
      {
        encodedEmail && (
          <span class="footer-email" data-e={encodedEmail} hidden>
            {' · '}
            <a>Email</a>
          </span>
        )
      }
    </footer>
    {encodedEmail && <script is:inline set:html={EMAIL_SCRIPT} />}
    {COUNTER_URL && <script is:inline set:html={COUNTER_SCRIPT} />}
  </body>
</html>

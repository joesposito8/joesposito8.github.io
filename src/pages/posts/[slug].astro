---
import katexStylesheet from 'katex/dist/katex.min.css?url';
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
// KaTeX's stylesheet and fonts load only on posts that contain math.
const hasMath = /\$/.test(post.body ?? '');
---

<Base title={post.data.title} description={post.data.subtitle} type="article" image={`/og/${post.id}.png`}>
  {hasMath && <link slot="head" rel="stylesheet" href={katexStylesheet} />}
  <Article post={post} />
</Base>

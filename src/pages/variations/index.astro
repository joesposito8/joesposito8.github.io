---
import { VARIATIONS, SHOWCASE_ESSAY } from '../../lib/variations';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Design variations</title>
    <style>
      body { font: 17px/1.6 system-ui, sans-serif; max-width: 700px; margin: 3rem auto; padding: 0 1rem; color-scheme: light dark; }
      li { margin-bottom: 1rem; }
    </style>
  </head>
  <body>
    <h1>Design variations</h1>
    <p>Round 4: three takes on H that borrow from Lil'Log, TurnTrout and joecarlsmith.com: a prose intro, one accent colour, a list of everything you can filter and sort, and a contents list on essays. H is kept for reference. Use the bar at the top of each page to switch variation, page and light/dark.</p>
    <ul>
      {
        Object.entries(VARIATIONS).map(([id, v]) => (
          <li>
            <strong>{id.toUpperCase()}: {v.name}</strong> ({v.spec})
            <br />
            <a href={`/variations/${id}/`}>Home stream</a> · <a href={`/variations/${id}/posts/${SHOWCASE_ESSAY}/`}>Essay</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>

---
import VariationLayout from '../../../layouts/VariationLayout.astro';
import StreamA from '../../../components/variations/StreamA.astro';
import StreamB from '../../../components/variations/StreamB.astro';
import StreamC from '../../../components/variations/StreamC.astro';
import { getPosts } from '../../../lib/posts';
import { VARIATIONS, type VariationId } from '../../../lib/variations';

export function getStaticPaths() {
  return Object.keys(VARIATIONS).map((v) => ({ params: { v } }));
}

const variant = Astro.params.v as VariationId;
const posts = await getPosts();
const Stream = { a: StreamA, b: StreamB, c: StreamC }[variant];
---

<VariationLayout variant={variant} page="home" title={`Variation ${variant.toUpperCase()}: home`}>
  <Stream posts={posts} base={`/variations/${variant}/`} />
</VariationLayout>

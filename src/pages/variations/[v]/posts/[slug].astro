---
import 'katex/dist/katex.min.css';
import VariationLayout from '../../../../layouts/VariationLayout.astro';
import Article from '../../../../components/Article.astro';
import { getPosts, type Post } from '../../../../lib/posts';
import { VARIATIONS, SHOWCASE_ESSAY, type VariationId } from '../../../../lib/variations';

export async function getStaticPaths() {
  const posts = await getPosts();
  return Object.keys(VARIATIONS).flatMap((v) => posts.map((post) => ({ params: { v, slug: post.id }, props: { post } })));
}

const variant = Astro.params.v as VariationId;
const { post } = Astro.props as { post: Post };
---

<VariationLayout variant={variant} page={post.id === SHOWCASE_ESSAY ? 'essay' : 'post'} title={post.data.title} slug={post.id}>
  <Article post={post} toc={VARIATIONS[variant].toc} endMark={VARIATIONS[variant].intro === 'prose'} />
</VariationLayout>

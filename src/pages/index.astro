---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import PostFilters from '../components/PostFilters.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <h1 class="sr-only">{SITE.name}</h1>
  <div class="home">
    <Intro />
    {
      posts.length > 0 && (
        <section class="writing with-rail" id="writing" aria-labelledby="writing-title">
          <h2 id="writing-title" class="writing-title">Writing</h2>
          <PostFilters posts={posts} />
          <PostList posts={posts} />
        </section>
      )
    }
  </div>
</Base>

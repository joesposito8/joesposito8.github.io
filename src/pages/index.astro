---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import PostFilters from '../components/PostFilters.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts } from '../lib/posts';
// The list's subtitles are italic and its topics are in the mono face. On wide screens the list
// shows at load, so these are preloaded to appear with the page. On phones the list starts
// below the fold, and preloading them would slow the two faces the top of the page needs.
import alegreyaItalicUrl from '@fontsource-variable/alegreya/files/alegreya-latin-wght-italic.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const posts = await getPosts();
---

<Base>
  {
    posts.length > 0 && (
      <Fragment slot="head">
        <link rel="preload" href={alegreyaItalicUrl} as="font" type="font/woff2" crossorigin media="(min-width: 80rem)" />
        <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin media="(min-width: 80rem)" />
      </Fragment>
    )
  }
  <h1 class="sr-only">{SITE.name}</h1>
  <div class="home">
    <Intro />
    {
      posts.length > 0 && (
        <section class="writing with-rail" id="writing" aria-labelledby="writing-title">
          <h2 id="writing-title" class="writing-title">Writing</h2>
          <PostFilters posts={posts} />
          <PostList posts={posts} />
        </section>
      )
    }
  </div>
</Base>

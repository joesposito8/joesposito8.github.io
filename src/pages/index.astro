---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import PostFilters from '../components/PostFilters.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <h1 class="sr-only">{SITE.name}</h1>
  <div class="home with-rail">
    <Intro />
    {
      posts.length > 0 && (
        <section class="writing" aria-labelledby="writing">
          {/* The heading carries the #writing anchor: on wide screens the section has no box of its own to scroll to. */}
          <h2 id="writing" class="writing-title">Writing</h2>
          <PostFilters posts={posts} />
          <PostList posts={posts} />
        </section>
      )
    }
  </div>
</Base>

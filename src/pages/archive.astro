---
import Base from '../layouts/Base.astro';
import { TYPE_LABELS, formatDate, groupBy, postUrl, getPosts } from '../lib/posts';

const posts = await getPosts();
const years = groupBy(posts, (p) => String(p.data.date.getUTCFullYear()));
---

<Base title="Archive" description="Every post by date.">
  <h1>Archive</h1>
  {
    years.map(([year, items]) => (
      <section class="archive-year" aria-labelledby={`y${year}`}>
        <h2 class="year" id={`y${year}`}>
          <span>{year}</span>
        </h2>
        <ol class="archive-list">
          {items.map((p) => (
            <li>
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, 'day-month')}</time>
              <a href={p.data.type === 'link' ? p.data.url : postUrl(p)}>{p.data.title}</a>
              <span class={`type sc t-${p.data.type}`}>{TYPE_LABELS[p.data.type]}</span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>
